{
  "name": "sayo",
  "version": "0.1.7",
  "description": "Windows dictation with your own Groq key, automatic paste and durable recovery",
  "author": "Sayo contributors",
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "npm run security:check && node scripts/build.mjs && npm run security:check",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --dir && npm run security:check",
    "dist": "npm run build && electron-builder --win portable && npm run security:check",
    "security:check": "node scripts/security-check.mjs",
    "install:local": "npm run pack && powershell -NoProfile -File scripts/apply-desktop-update.ps1",
    "security:staged": "node scripts/security-check.mjs --staged"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "local.vool.desktop",
    "productName": "Sayo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/*.test.cjs",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "native/VOOL.Input.exe",
        "to": "VOOL.Input.exe"
      }
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "src/icon.ico"
    },
    "portable": {
      "artifactName": "Sayo-${version}-Windows.exe"
    }
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GiftChiputa/sayo.git"
  },
  "bugs": {
    "url": "https://github.com/GiftChiputa/sayo/issues"
  },
  "homepage": "https://github.com/GiftChiputa/sayo#readme"
}
